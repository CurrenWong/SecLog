.guide-page {
  padding: 32rpx;
  min-height: 100vh;
  background-color: #f7f8fa;
}

.hero {
  text-align: center;
  padding: 48rpx 0 32rpx;
}

.logo {
  font-size: 64rpx;
  font-weight: 900;
  color: #07c160;
  letter-spacing: 8rpx;
}

.slogan {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #888;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin: 40rpx 0 24rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #07c160;
}

.guide-card {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.guide-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  line-height: 1.4;
}

.guide-body {
  flex: 1;
}

.guide-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 10rpx;
}

.guide-card-desc {
  font-size: 26rpx;
  color: #777;
  line-height: 1.6;
}

.faq-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.faq-q {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.faq-a {
  font-size: 26rpx;
  color: #777;
  line-height: 1.6;
}

.btn-group {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-primary {
  background-color: #07c160;
  color: #fff;
  border-radius: 12rpx;
  padding: 26rpx;
  font-size: 32rpx;
  text-align: center;
}

.btn-light {
  background-color: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
  border-radius: 12rpx;
  padding: 26rpx;
  font-size: 32rpx;
  text-align: center;
}
