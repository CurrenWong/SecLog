<view class="guide-page">
  <view class="hero">
    <view class="logo">秒记</view>
    <view class="slogan">说话即记账 · AI 帮你管钱</view>
  </view>

  <view class="section-title">怎么用</view>
  <view class="guide-list">
    <view class="guide-card" wx:for="{{guides}}" wx:key="title">
      <view class="guide-icon">{{item.icon}}</view>
      <view class="guide-body">
        <view class="guide-card-title">{{item.title}}</view>
        <view class="guide-card-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="section-title">常见问题</view>
  <view class="faq-list">
    <view class="faq-card" wx:for="{{faqs}}" wx:key="q">
      <view class="faq-q">Q：{{item.q}}</view>
      <view class="faq-a">A：{{item.a}}</view>
    </view>
  </view>

  <view class="btn-group">
    <view class="btn-primary" bind:tap="goChat">开始记账</view>
    <view class="btn-light" bind:tap="goHome">返回首页</view>
  </view>
</view>
