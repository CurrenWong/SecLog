.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
  padding-bottom: 120rpx;
}

/* ⭐ 智能输入卡片 */
.ai-card {
  background: linear-gradient(135deg, #e3f2fd 0%, #e8f5e9 100%);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.ai-header {
  margin-bottom: 20rpx;
}

.ai-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.ai-subtitle {
  font-size: 24rpx;
  color: #888;
  margin-left: 12rpx;
}

.ai-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 50rpx;
  padding: 6rpx 20rpx 6rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.ai-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 72rpx;
  line-height: 72rpx;
  min-height: 72rpx;
}

.ai-voice {
  background: #e8f5e9;
  font-size: 44rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.1s;
}

.ai-voice.recording {
  background: #ffebee;
  transform: scale(1.15);
  box-shadow: 0 0 16rpx rgba(244, 67, 54, 0.4);
  animation: voice-pulse 0.8s ease-in-out infinite;
}

.ai-send {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

@keyframes voice-pulse {
  0%, 100% { box-shadow: 0 0 8rpx rgba(244, 67, 54, 0.3); }
  50% { box-shadow: 0 0 24rpx rgba(244, 67, 54, 0.6); }
}

.ai-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.picker, .input {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.picker.readonly {
  color: #999;
  background: #f5f5f5;
}

.input {
  width: 100%;
  box-sizing: border-box;
  line-height: 2.4;
  min-height: 88rpx;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 180rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 2.4;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 地点选择 */
.location-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.location-left {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.location-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.location-text .placeholder {
  color: #bbb;
}

.location-icon {
  font-size: 36rpx;
  margin-left: 12rpx;
}

.location-view-btn {
  width: 72rpx;
  height: 72rpx;
  margin: 12rpx 20rpx 12rpx 0;
  background: #e8f5e9;
  font-size: 36rpx;
  color: #07c160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.location-coords {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  padding-left: 8rpx;
}

/* 照片 */
.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-item {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.photo-item image {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
}

.photo-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #ccc;
}

/* 保存按钮 */
.save-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
}