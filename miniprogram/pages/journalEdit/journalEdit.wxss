.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
  padding-bottom: 120rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.picker, .input {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.picker.readonly {
  color: #999;
  background: #f5f5f5;
}

.input {
  width: 100%;
  box-sizing: border-box;
}

/* 语音输入 */
.voice-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx;
  background: #e8f5e9;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.voice-icon {
  font-size: 48rpx;
}

.voice-text {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 500;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 180rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 地点选择 */
.location-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.location-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.location-text .placeholder {
  color: #bbb;
}

.location-icon {
  font-size: 36rpx;
}

.location-coords {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  padding-left: 8rpx;
}

/* 照片 */
.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-item {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.photo-item image {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
}

.photo-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #ccc;
}

/* 保存按钮 */
.save-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
}