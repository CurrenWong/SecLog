.home {
  padding: 32rpx;
  min-height: 100vh;
  background-color: #f7f8fa;
}

/* 品牌头部 */
.header {
  position: relative;
  text-align: center;
  padding: 40rpx 0 32rpx;
}

/* 右上角个人中心入口 */
.profile-entry {
  position: absolute;
  top: 32rpx;
  right: 8rpx;
}
.profile-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8e8e8;
  display: block;
}

.brand-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.18);
}

.brand {
  font-size: 72rpx;
  font-weight: 900;
  color: #07c160;
  letter-spacing: 10rpx;
}

.brand-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #999;
}

/* 汇总卡片 */
.summary-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 0;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.summary-col {
  flex: 1;
  text-align: center;
}

.summary-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.summary-value {
  font-size: 44rpx;
  font-weight: 700;
}

.summary-value.expense {
  color: #ff6b6b;
}

.summary-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

/* 主入口 CTA */
.cta {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #07c160, #0aa85a);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.3);
}

.cta-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 24rpx;
  border-radius: 16rpx;
  background: #07c160;
  color: #fff;
  font-size: 56rpx;
  line-height: 64rpx;
  text-align: center;
  font-weight: 300;
}

.cta-text {
  flex: 1;
}

.cta-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.cta-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

.cta-arrow {
  font-size: 56rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 最近记录 */
.recent {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.recent-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.recent-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.recent-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.recent-more {
  font-size: 24rpx;
  color: #07c160;
}

.record {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record:last-child {
  border-bottom: none;
}

.record-cat {
  width: 96rpx;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.record-note {
  flex: 1;
  font-size: 26rpx;
  color: #999;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding: 0 16rpx;
}

.record-time {
  font-size: 22rpx;
  color: #bbb;
  margin-right: 16rpx;
}

.record-amount {
  font-size: 30rpx;
  font-weight: 600;
}

.record-amount.expense {
  color: #ff6b6b;
}

.record-amount.income {
  color: #07c160;
}

.empty {
  text-align: center;
  font-size: 26rpx;
  color: #aaa;
  padding: 40rpx 0;
}

/* 引导入口 */
.guide-entry {
  text-align: center;
  font-size: 26rpx;
  color: #07c160;
  padding: 20rpx;
}
