<view class="home">
  <!-- 品牌头部 -->
  <view class="header">
    <image class="brand-logo" src="/images/app-logo.png" mode="aspectFill" />
    <view class="brand">秒记账</view>
    <view class="brand-sub">说话即记账 · AI 帮你管钱</view>
    <view class="profile-entry" bind:tap="goProfile">
      <image class="profile-avatar" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
    </view>
  </view>

  <!-- 汇总卡片 -->
  <view class="summary-card">
    <view class="summary-col">
      <view class="summary-label">今日支出</view>
      <view class="summary-value expense">¥{{summary.dayExpenseText}}</view>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-col">
      <view class="summary-label">本月支出</view>
      <view class="summary-value expense">¥{{summary.monthExpenseText}}</view>
    </view>
  </view>

  <!-- 主入口 -->
  <view class="cta" bind:tap="goChat">
    <view class="cta-icon">+</view>
    <view class="cta-text">
      <view class="cta-title">开始记账</view>
      <view class="cta-sub">说一句"午饭38"就记好了</view>
    </view>
    <view class="cta-arrow">></view>
  </view>

  <!-- 最近记录 -->
  <view class="recent">
    <view class="recent-head">
      <text class="recent-title">最近记录</text>
      <view class="recent-actions">
        <text class="recent-more" bind:tap="goRecords">查看明细 ></text>
        <text class="recent-more" bind:tap="goChat">记一笔 ></text>
      </view>
    </view>

    <view wx:if="{{loading}}" class="empty">加载中…</view>

    <view wx:elif="{{recent.length === 0}}" class="empty">还没有记录，点上方「开始记账」试试吧</view>

    <view wx:else class="recent-list">
      <view class="record" wx:for="{{recent}}" wx:key="_id">
        <view class="record-cat">{{item.category}}</view>
        <view class="record-note">{{item.note || '无备注'}}</view>
        <view class="record-time">{{item.time}}</view>
        <view class="record-amount {{item.type === 'income' ? 'income' : 'expense'}}">
          {{item.type === 'income' ? '+' : '-'}}¥{{item.amountText}}
        </view>
      </view>
    </view>
  </view>

  <!-- 引导入口 -->
  <view class="guide-entry" bind:tap="goGuide">如何使用秒记账 ></view>
</view>
