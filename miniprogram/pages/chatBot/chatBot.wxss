/* pages/chatBot/chatBot.wxss */

/* 拍照记账浮动按钮 */
.photo-fab {
  position: fixed;
  right: 36rpx;
  /* 提到足够避开 agent-ui 底部输入栏（约 200rpx 高） */
  bottom: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  height: 130rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0, 150, 255, 0.35);
  z-index: 100;
}
/* 纯 CSS 相机图标，不依赖系统 emoji 字体 */
.photo-fab-icon {
  position: relative;
  width: 50rpx;
  height: 38rpx;
  margin-bottom: 4rpx;
}
.cam-body {
  position: absolute;
  inset: 6rpx 0 0 0;
  background: #fff;
  border-radius: 6rpx;
}
.cam-lens {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border: 3rpx solid #fff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}
.cam-flash {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 6rpx;
  background: #fff;
  border-radius: 2rpx 2rpx 0 0;
}
.photo-fab-text {
  font-size: 18rpx;
  color: #fff;
  margin-top: 4rpx;
}

/* OCR 确认弹窗 */
.ocr-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}
.ocr-card {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.18);
}
.ocr-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
  color: #222;
}
.ocr-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.ocr-label {
  width: 90rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}
.ocr-input {
  flex: 1;
  height: 72rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #fafafa;
}
.ocr-picker {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #fafafa;
  color: #333;
}
.ocr-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}
.ocr-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin: 0;
}
.ocr-btn-cancel {
  background: #f0f0f0;
  color: #666;
}
.ocr-btn-confirm {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #fff;
}

/* 识别中 loading */
.ocr-loading {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}
.ocr-loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 60rpx;
  color: #555;
  font-size: 28rpx;
}
.ocr-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #4facfe;
  border-radius: 50%;
  animation: ocr-spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}
@keyframes ocr-spin {
  to {
    transform: rotate(360deg);
  }
}
