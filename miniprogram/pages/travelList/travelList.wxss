.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

/* 顶部操作栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.btn-speech, .btn-new {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.btn-speech {
  background: #e8f5e9;
  color: #07c160;
}

.btn-new {
  background: #07c160;
  color: #fff;
}

.icon {
  font-size: 28rpx;
}

/* 加载 & 空状态 */
.loading, .empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
}

/* 旅程卡片列表 */
.trip-list {
  max-height: calc(100vh - 160rpx);
}

.trip-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.trip-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.trip-cover image {
  width: 100%;
  height: 100%;
}

.trip-body {
  flex: 1;
  min-width: 0;
}

.trip-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 2;
  margin-bottom: 8rpx;
}

.trip-meta {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.trip-stats {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.stat {
  font-size: 22rpx;
  color: #07c160;
}

.trip-summary {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.trip-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  color: #ccc;
}