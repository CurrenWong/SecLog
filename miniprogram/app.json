{
  "pages": [
    "pages/index/index",
    "pages/chatBot/chatBot",
    "pages/guide/guide",
    "pages/profile/profile",
    "pages/records/records",
    "pages/travelList/travelList",
    "pages/tripDetail/tripDetail",
    "pages/journalEdit/journalEdit",
    "pages/tripEdit/tripEdit",
    "pages/batchJournal/batchJournal"
  ],
  "usingComponents": {
    "custom-map": "/components/toolCard/map/index",
    "custom-weather": "/components/toolCard/weather/index",
    "custom-food-list": "/components/toolCard/food-list/index",
    "custom-business-list": "/components/toolCard/business-list/index"
  },
  "window": {
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "秒记账",
    "backgroundColor": "#f7f8fa",
    "backgroundTextStyle": "light",
    "enablePullDownRefresh": true
  },
  "plugins": {
    "WechatSI": {
      "version": "0.3.9",
      "provider": "WX_PROVIDER_APPID_PLACEHOLDER"
    }
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "permission": {
    "scope.userLocation": {
      "desc": "用于选择地点和查看位置"
    }
  },
  "requiredPrivateInfos": [
    "chooseLocation",
    "getLocation"
  ],
  "networkTimeout": {
    "request": 300000,
    "connectSocket": 60000,
    "uploadFile": 60000,
    "downloadFile": 60000
  }
}